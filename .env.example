APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# GALY shared catalog, accounts, cart, and order database.
# By default this reuses the DB host and credentials above and selects database `galy`.
# Set separate GALY_DB_* values when GALY is hosted on another MySQL server.
GALY_DB_DATABASE=galy
GALY_API_URL=http://localhost/galy_api
GALY_PUBLIC_URL=http://localhost/galy-admin
# Set to the X-GALY-KEY value configured in the GALY API when Laravel is not local to it.
GALY_API_KEY=
# Set this to the shared API image directory on the server.
GALY_IMAGES_PATH=C:/xampp/htdocs/galy_api/img
# REST API of the GALY Angular admin panel (used for single-use SSO links).
GALY_ADMIN_API_URL=http://localhost/galy-admin/api/v1
# Shared HMAC secret. Must match GALY_WEB_SSO_SECRET in the galy-admin backend .env.
GALY_SSO_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
PAYPAL_PAYMENT_ACTION=Sale
PAYPAL_CURRENCY=USD
PAYPAL_NOTIFY_URL=
PAYPAL_LOCALE=en_US
PAYPAL_VALIDATE_SSL=true
PAYPAL_TIMEOUT=30
PAYPAL_CONNECT_TIMEOUT=10
PAYPAL_MAX_RETRIES=2

# Mercado Pago se configura en el bloque de más abajo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#///////////////////////MERCADO PAGO (pago con tarjeta)////////////////////////
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=PEN
MERCADOPAGO_CHECKOUT_TTL_MINUTES=30
MERCADOPAGO_STATEMENT_DESCRIPTOR=GALY
# Public key for the in-page card form (Checkout Bricks / Transparente).
MERCADOPAGO_PUBLIC_KEY=
# Turn on only after the public key above is set; otherwise card payments keep
# using the hosted Checkout Pro redirect.
MERCADOPAGO_BRICKS=false
# Public HTTPS URL Mercado Pago can return to and notify. Falls back to APP_URL.
MERCADOPAGO_URL_BASE=

#///////////////////////IZIPAY (pago con tarjeta, opcional)///////////////////
# Pasarela adicional a Mercado Pago. El cobro lo hace el formulario embebido de
# Izipay; la tienda no recibe ni guarda el numero ni el CVV.
IZIPAY_ENABLED=false
IZIPAY_SHOP_ID=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=
# production = api.micuentaweb.pe | sandbox = sandbox-api.micuentaweb.pe
IZIPAY_ENVIRONMENT=production
IZIPAY_CHECKOUT_TTL_MINUTES=30
# URL publica (HTTPS) para el retorno y la IPN. Si va vacia se usa APP_URL.
IZIPAY_URL_BASE=
IZIPAY_API_URL=
IZIPAY_SCRIPT_URL=
#///////////////////////ENVÍOS DE LA TIENDA///////////////////////////////////
# Subtotal from which standard delivery becomes free, and both delivery costs.
ENVIO_UMBRAL_GRATIS=300
ENVIO_COSTO_ESTANDAR=20
ENVIO_COSTO_EXPRESS=50
